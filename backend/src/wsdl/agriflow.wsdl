<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://agriflow.id/soap"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  name="AgriFlowService"
                  targetNamespace="http://agriflow.id/soap">

  <!-- ========================================== -->
  <!-- TYPES / XSD SCHEMA DEFINITION              -->
  <!-- ========================================== -->
  <wsdl:types>
    <xsd:schema targetNamespace="http://agriflow.id/soap" elementFormDefault="qualified">

      <!-- 1. LoginUser -->
      <xsd:element name="LoginUserRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Email" type="xsd:string"/>
            <xsd:element name="Password" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="LoginUserResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="UserId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Email" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Name" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Role" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
            <xsd:element name="AccessToken" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 2. RegisterUser -->
      <xsd:element name="RegisterUserRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Fullname" type="xsd:string"/>
            <xsd:element name="Email" type="xsd:string"/>
            <xsd:element name="Password" type="xsd:string"/>
            <xsd:element name="Role" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="RegisterUserResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="UserId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Email" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Name" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Role" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 3. GetPetaniByNIK -->
      <xsd:element name="GetPetaniByNIKRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="NIK" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetPetaniByNIKResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Found" type="xsd:boolean"/>
            <xsd:element name="PetaniId" type="xsd:string" minOccurs="0"/>
            <xsd:element name="NIK" type="xsd:string" minOccurs="0"/>
            <xsd:element name="NamaLengkap" type="xsd:string" minOccurs="0"/>
            <xsd:element name="NomorHp" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Alamat" type="xsd:string" minOccurs="0"/>
            <xsd:element name="DesaKelurahan" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Kecamatan" type="xsd:string" minOccurs="0"/>
            <xsd:element name="KabupatenKota" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Provinsi" type="xsd:string" minOccurs="0"/>
            <xsd:element name="LuasLahan" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="Sektor" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
            <xsd:element name="UserIdPengecer" type="xsd:int" minOccurs="0"/>
            <xsd:element name="AwalTerdaftar" type="xsd:string" minOccurs="0"/>
            <xsd:element name="AkhirTerdaftar" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 4. CekKuotaPetani -->
      <xsd:element name="CekKuotaPetaniRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PetaniId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemKuota">
        <xsd:sequence>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="SisaKuota" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="CekKuotaPetaniResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PetaniId" type="xsd:string"/>
            <xsd:element name="NamaPetani" type="xsd:string"/>
            <xsd:element name="ListKuota" type="tns:ItemKuota" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 5. GetPetaniList -->
      <xsd:element name="GetPetaniListRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdPengecer" type="xsd:int" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemPetaniSummary">
        <xsd:sequence>
          <xsd:element name="PetaniId" type="xsd:string"/>
          <xsd:element name="NamaLengkap" type="xsd:string"/>
          <xsd:element name="NomorHp" type="xsd:string"/>
          <xsd:element name="Alamat" type="xsd:string"/>
          <xsd:element name="LuasLahan" type="xsd:decimal"/>
          <xsd:element name="Sektor" type="xsd:string"/>
          <xsd:element name="Status" type="xsd:string"/>
          <xsd:element name="UserIdPengecer" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetPetaniListResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListPetani" type="tns:ItemPetaniSummary" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 6. PenebusanPupuk -->
      <xsd:element name="PenebusanPupukRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
            <xsd:element name="PetaniId" type="xsd:string"/>
            <xsd:element name="PupukId" type="xsd:int"/>
            <xsd:element name="Jumlah" type="xsd:decimal"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="PenebusanPupukResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="TebusanId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
            <xsd:element name="JumlahDitebus" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="SisaKuota" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="Timestamp" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 7. GetRiwayatPenebusan -->
      <xsd:element name="GetRiwayatPenebusanRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemRiwayatPenebusan">
        <xsd:sequence>
          <xsd:element name="TebusanId" type="xsd:int"/>
          <xsd:element name="PetaniId" type="xsd:string"/>
          <xsd:element name="NamaPetani" type="xsd:string"/>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="Jumlah" type="xsd:decimal"/>
          <xsd:element name="Status" type="xsd:string"/>
          <xsd:element name="Timestamp" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetRiwayatPenebusanResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListRiwayat" type="tns:ItemRiwayatPenebusan" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 8. CekStok & CekStokPengecer -->
      <xsd:element name="CekStokRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CekStokPengecerRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemStok">
        <xsd:sequence>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="JumlahStok" type="xsd:decimal"/>
          <xsd:element name="TerakhirUpdate" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="CekStokResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="NamaUser" type="xsd:string"/>
            <xsd:element name="Role" type="xsd:string"/>
            <xsd:element name="ListStok" type="tns:ItemStok" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CekStokPengecerResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
            <xsd:element name="NamaPengecer" type="xsd:string"/>
            <xsd:element name="ListStok" type="tns:ItemStok" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 9. GetRiwayatStok -->
      <xsd:element name="GetRiwayatStokRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemRiwayatStok">
        <xsd:sequence>
          <xsd:element name="RiwayatId" type="xsd:int"/>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="JumlahAwal" type="xsd:decimal"/>
          <xsd:element name="JumlahAkhir" type="xsd:decimal"/>
          <xsd:element name="TipePerubahan" type="xsd:string"/>
          <xsd:element name="Timestamp" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetRiwayatStokResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListRiwayat" type="tns:ItemRiwayatStok" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 10. AdjustStok -->
      <xsd:element name="AdjustStokRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="PupukId" type="xsd:int"/>
            <xsd:element name="JumlahPenyesuaian" type="xsd:decimal"/>
            <xsd:element name="Keterangan" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="AdjustStokResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="PupukId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="JumlahAwal" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="JumlahAkhir" type="xsd:decimal" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 11. CreateKirimanPupuk -->
      <xsd:element name="CreateKirimanPupukRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserIdDistributor" type="xsd:int"/>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
            <xsd:element name="PupukId" type="xsd:int"/>
            <xsd:element name="Jumlah" type="xsd:decimal"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CreateKirimanPupukResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="KirimanId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
            <xsd:element name="JumlahDikirim" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="NamaPupuk" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 12. TerimaKirimanPupuk -->
      <xsd:element name="TerimaKirimanPupukRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="KirimanId" type="xsd:int"/>
            <xsd:element name="UserIdPengecer" type="xsd:int"/>
            <xsd:element name="JumlahDiterima" type="xsd:decimal" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="TerimaKirimanPupukResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="KirimanId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
            <xsd:element name="JumlahDiterima" type="xsd:decimal" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 13. GetKirimanList -->
      <xsd:element name="GetKirimanListRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="Role" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemKiriman">
        <xsd:sequence>
          <xsd:element name="KirimanId" type="xsd:int"/>
          <xsd:element name="UserIdDistributor" type="xsd:int"/>
          <xsd:element name="NamaDistributor" type="xsd:string"/>
          <xsd:element name="UserIdPengecer" type="xsd:int"/>
          <xsd:element name="NamaPengecer" type="xsd:string"/>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="JumlahDikirim" type="xsd:decimal"/>
          <xsd:element name="JumlahDiterima" type="xsd:decimal"/>
          <xsd:element name="Status" type="xsd:string"/>
          <xsd:element name="TimestampDikirim" type="xsd:string"/>
          <xsd:element name="TimestampDiterima" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetKirimanListResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListKiriman" type="tns:ItemKiriman" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 14. GetNotifikasi -->
      <xsd:element name="GetNotifikasiRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="UnreadOnly" type="xsd:boolean" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemNotifikasi">
        <xsd:sequence>
          <xsd:element name="NotifikasiId" type="xsd:int"/>
          <xsd:element name="Jenis" type="xsd:string"/>
          <xsd:element name="Judul" type="xsd:string"/>
          <xsd:element name="Pesan" type="xsd:string"/>
          <xsd:element name="StatusDibaca" type="xsd:boolean"/>
          <xsd:element name="Timestamp" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetNotifikasiResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListNotifikasi" type="tns:ItemNotifikasi" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 15. MarkNotifikasiDibaca -->
      <xsd:element name="MarkNotifikasiDibacaRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="NotifikasiId" type="xsd:int" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="MarkNotifikasiDibacaResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 16. GetUnreadCount -->
      <xsd:element name="GetUnreadCountRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetUnreadCountResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UnreadCount" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 17. GetDashboardPemerintah -->
      <xsd:element name="GetDashboardPemerintahRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="TahunAwal" type="xsd:int" minOccurs="0"/>
            <xsd:element name="TahunAkhir" type="xsd:int" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetDashboardPemerintahResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="TotalTerserapTon" type="xsd:decimal"/>
            <xsd:element name="TotalSisaKuotaKg" type="xsd:decimal"/>
            <xsd:element name="TotalAlokasiKg" type="xsd:decimal"/>
            <xsd:element name="RealisasiPersen" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 18. GetPendingUsers -->
      <xsd:element name="GetPendingUsersRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Page" type="xsd:int" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemPendingUser">
        <xsd:sequence>
          <xsd:element name="UserId" type="xsd:int"/>
          <xsd:element name="NamaLengkap" type="xsd:string"/>
          <xsd:element name="Email" type="xsd:string"/>
          <xsd:element name="Role" type="xsd:string"/>
          <xsd:element name="Status" type="xsd:string"/>
          <xsd:element name="TanggalDaftar" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetPendingUsersResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Total" type="xsd:int"/>
            <xsd:element name="ListUsers" type="tns:ItemPendingUser" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 19. ApproveUser -->
      <xsd:element name="ApproveUserRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="ApproverId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ApproveUserResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="UserId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 20. RejectUser -->
      <xsd:element name="RejectUserRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="UserId" type="xsd:int"/>
            <xsd:element name="ApproverId" type="xsd:int"/>
            <xsd:element name="Alasan" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="RejectUserResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="UserId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 21. GetDeteksiAnomali -->
      <xsd:element name="GetDeteksiAnomaliRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="BatasKg" type="xsd:decimal" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="ItemAnomali">
        <xsd:sequence>
          <xsd:element name="TebusanId" type="xsd:int"/>
          <xsd:element name="PetaniId" type="xsd:string"/>
          <xsd:element name="NamaPetani" type="xsd:string"/>
          <xsd:element name="NamaPengecer" type="xsd:string"/>
          <xsd:element name="PupukId" type="xsd:int"/>
          <xsd:element name="NamaPupuk" type="xsd:string"/>
          <xsd:element name="JumlahKg" type="xsd:decimal"/>
          <xsd:element name="AlasanAnomali" type="xsd:string"/>
          <xsd:element name="Timestamp" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="GetDeteksiAnomaliResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="TotalAnomali" type="xsd:int"/>
            <xsd:element name="BatasAmbangKg" type="xsd:decimal"/>
            <xsd:element name="ListAnomali" type="tns:ItemAnomali" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- 22. CreateBantuan -->
      <xsd:element name="CreateBantuanRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="FirstName" type="xsd:string"/>
            <xsd:element name="MiddleName" type="xsd:string" minOccurs="0"/>
            <xsd:element name="LastName" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Email" type="xsd:string"/>
            <xsd:element name="Topik" type="xsd:string"/>
            <xsd:element name="Ringkasan" type="xsd:string"/>
            <xsd:element name="UserId" type="xsd:int" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CreateBantuanResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Success" type="xsd:boolean"/>
            <xsd:element name="Message" type="xsd:string"/>
            <xsd:element name="BantuanId" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Topik" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Email" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
